# Build-time configuration for the Electron desktop build.
#
# Used by `npm run build:desktop` (vite build --mode desktop).
#
# The desktop app loads its HTML from file://, so a relative "/api" has nothing
# to resolve against -- these must be absolute URLs pointing at your deployed
# backend. Change them here and rebuild; they are inlined into the bundle.
#
# Nothing here is secret: every VITE_* value ships inside the bundle and is
# readable by anyone who installs the app. Never put a key in this file.

VITE_DESKTOP_API_BASE_URL=https://dayfllow.onrender.com/api
VITE_WS_URL=wss://dayfllow.onrender.com/ws/updates/
