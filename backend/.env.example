# ============================================================================
# DayFlow backend configuration
# ============================================================================
# Copy to .env and fill in. Settings fail closed: with DJANGO_DEBUG off, the
# app refuses to start unless the required values below are present, rather
# than silently falling back to an insecure default.
#
# Required in production are marked [REQUIRED].

# ---- Core ------------------------------------------------------------------
# [REQUIRED] Generate with:
#   python -c 'from django.core.management.utils import get_random_secret_key as g; print(g())'
DJANGO_SECRET_KEY=

# Leave false in production. Turning it on exposes stack traces and relaxes
# every other guard in this file.
DJANGO_DEBUG=false

# [REQUIRED] Comma-separated hostnames that may serve this API.
DJANGO_ALLOWED_HOSTS=api.dayflow.app

# [REQUIRED] Exact frontend origins allowed to call the API. There is no
# wildcard: the previous CORS_ALLOW_ALL_ORIGINS=True let any site call it.
DJANGO_CORS_ALLOWED_ORIGINS=https://app.dayflow.app
# DJANGO_CSRF_TRUSTED_ORIGINS defaults to the CORS list.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.dayflow.app

# The Electron desktop build loads from file:// and sends "Origin: null".
# Only enable if you ship the desktop app.
DJANGO_ALLOW_DESKTOP_ORIGIN=false

# ---- Database --------------------------------------------------------------
# [REQUIRED] Postgres. SQLite is not supported in production.
DATABASE_URL=postgres://user:password@host:5432/dayflow
# Or the discrete form: DB_NAME / DB_USER / DB_PASSWORD / DB_HOST / DB_PORT
# DJANGO_DB_SSL_REQUIRE=true
# DJANGO_DB_CONN_MAX_AGE=600
# Local development only -- never set this in production.
# DJANGO_ALLOW_SQLITE=false

# ---- Realtime --------------------------------------------------------------
# [REQUIRED] Redis backs the WebSocket channel layer. The in-memory layer only
# works with exactly one worker process.
REDIS_URL=redis://localhost:6379/0
# DJANGO_ALLOW_INMEMORY_CHANNELS=false

# ---- Billing (Stripe, USD) -------------------------------------------------
# [REQUIRED] From https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# [REQUIRED] From the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_API_VERSION=2025-10-29.clover
BILLING_CURRENCY=usd
BILLING_TRIAL_DAYS=14
BILLING_SUCCESS_URL=https://app.dayflow.app/#/billing/success
BILLING_CANCEL_URL=https://app.dayflow.app/#/billing/cancelled
# Set true to run without billing on purpose.
# DJANGO_ALLOW_UNCONFIGURED_BILLING=false

# ---- Email -----------------------------------------------------------------
# Required for password reset and employee invitations.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=DayFlow <no-reply@dayflow.app>
FRONTEND_BASE_URL=https://app.dayflow.app
# Password reset link lifetime, in seconds.
DJANGO_PASSWORD_RESET_TIMEOUT=3600

# ---- Tokens ----------------------------------------------------------------
DJANGO_ACCESS_TOKEN_MINUTES=15
DJANGO_REFRESH_TOKEN_DAYS=7
# Defaults to DJANGO_SECRET_KEY. Set separately to rotate one without the other.
# DJANGO_JWT_SIGNING_KEY=

# ---- Rate limits -----------------------------------------------------------
DJANGO_THROTTLE_LOGIN=10/min
DJANGO_THROTTLE_SIGNUP=5/hour
DJANGO_THROTTLE_PASSWORD_RESET=5/hour
DJANGO_THROTTLE_BILLING=30/min
DJANGO_THROTTLE_EXPORT=10/hour

# ---- Transport -------------------------------------------------------------
# Set false only if something upstream already redirects to HTTPS.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
# True on Render/Heroku/most PaaS, where TLS terminates at the proxy.
DJANGO_BEHIND_TLS_PROXY=true

# ---- Misc ------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
DJANGO_PAGE_SIZE=50
DJANGO_PASSWORD_MIN_LENGTH=10

# ---- Deprecated ------------------------------------------------------------
# Razorpay is being replaced by Stripe. The keys previously hardcoded in
# settings.py are public in git history and must be rotated.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
